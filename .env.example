# Copy to .env (gitignored) or set these in your shell. Never commit real values.
# OAuth "Desktop app" client JSON downloaded from Google Cloud Console (YouTube Data API v3 enabled)
YT_CLIENT_SECRETS_FILE=.secrets/client_secret.json
# Where the user token is cached after the first browser sign-in
YT_TOKEN_FILE=.secrets/yt_token.json
# Optional: target a channel by ID instead of the token's own channel
YT_CHANNEL_ID=
# Optional overrides
YTBULK_CONFIG=config/rules.yaml
YTBULK_OUTPUT_DIR=output
